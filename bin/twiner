#!/usr/bin/env bash
# twiner: start/stop/restart the twiner local dev stack (scenario API, web
# frontend and docs site) in a tmux session, so both run in the background across
# terminal sessions instead of needing two manually-managed `nohup` shells
# (see docs/ for the "server wasn't running" class of bug this replaces).
#
# Usage: twiner start|restart [local|prod]  |  twiner stop|status|attach
#
# `local` (default): both a local uvicorn scenario API and the web
# frontend, matching the original behavior.
# `prod`: only the web frontend, pointed at the deployed AWS backend
# (see docs/deploy-aws-setup.md) instead of starting a local API -- for
# checking the real deployed backend from the local dev frontend, e.g. to
# reproduce docs/known-issues-cloud-deploy.md's latency findings.
#
# Optional: symlink this onto your PATH, e.g.:
#   ln -s "$(pwd)/bin/twiner" /usr/local/bin/twiner
#
# Worktrees: each checkout gets its own tmux session ("twiner" for the main
# worktree, "twiner-<dir>" for a linked one) and, on start, the first free
# ports from 8000 (API), 5173 (frontend) and 4321 (docs) -- so a worktree's
# stack runs alongside main's instead of refusing to start. The frontend is
# pointed at its own API port. `twiner status` prints the URLs.
#
# Docs (apps/docs, Starlight): the frontend's Vite dev server proxies /docs
# to the docs dev server (TWINER_DOCS_PORT, apps/web/vite.config.ts), so
# http://localhost:5173/docs/ works like https://twiner.arredon.do/docs/
# and the hazard cards' info links work locally unchanged.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# A linked worktree's .git is a file; the main worktree's is a directory.
if [[ -f "$REPO_ROOT/.git" ]]; then
  SESSION="twiner-$(basename "$REPO_ROOT" | tr '.:' '__')"
else
  SESSION="twiner"
fi

# Defaults to the national dataset (see README's Quickstart for how it's
# built). buildings.parquet is always a per-municipality partitioned glob
# (no single combined file exists, by design -- region.py); exposure.parquet
# is a single combined file (region.combine_exposure), regenerated whenever
# the crawl changes. Override for a smaller/faster local dataset, e.g. a
# single-municipality test crawl:
#   TWINER_BUILDINGS_PATH="data/test-municipality/parts/*.buildings.parquet" \
#   TWINER_EXPOSURE_PATH="data/test-municipality/exposure.parquet" \
#   twiner start
# The census-section sites file (ADR-0024: the parts' columns the engine
# reads, plus each building's census section, dwellings and built area --
# built by `exposure.census_sections_cli`) when it exists, since impact
# estimates need it; the parts glob otherwise (damage still works, the
# impact figures come out without population, cost or debris).
if [[ -z "${TWINER_BUILDINGS_PATH:-}" && -f "$REPO_ROOT/data/exposure/buildings-cloud-impact.parquet" ]]; then
  TWINER_BUILDINGS_PATH="data/exposure/buildings-cloud-impact.parquet"
fi
: "${TWINER_BUILDINGS_PATH:=data/exposure/parts/*.buildings.parquet}"
: "${TWINER_EXPOSURE_PATH:=data/exposure/exposure.parquet}"

# Scenario result cache (docs/decisions/0018-scenario-result-cache.md): off
# by default locally, so every run recomputes against whatever calculation
# code/data you currently have. Opt in to test the cache itself, e.g.:
#   TWINER_SCENARIO_CACHE=1 twiner start
# With it on, bump TWINER_DATA_VERSION after rebuilding local data, or old
# results under results/ keep being served.
: "${TWINER_SCENARIO_CACHE:=0}"
: "${TWINER_DATA_VERSION:=dev}"

# AEMET OpenData API key for the real-time stations layer (ADR-0026; free,
# requested by email at https://opendata.aemet.es/centrodedescargas/altaUsuario).
# Kept out of the repo: taken from the environment, else from
# ~/.config/twiner/aemet_api_key (shared by every worktree). Keys EXPIRE
# after ~3 months (the current one on 2027-01-07) -- AEMET then answers
# 401 and the layer reports itself unavailable; request a new one and
# replace the file. Unset, only that one layer is affected.
AEMET_KEY_FILE="$HOME/.config/twiner/aemet_api_key"
if [[ -z "${TWINER_AEMET_API_KEY:-}" && -r "$AEMET_KEY_FILE" ]]; then
  TWINER_AEMET_API_KEY="$(tr -d '[:space:]' < "$AEMET_KEY_FILE")"
fi
: "${TWINER_AEMET_API_KEY:=}"

# The deployed Lambda Function URLs (infra's `ScenarioFunctionUrl`/
# `TilesFunctionUrl` CDK outputs, docs/deploy-aws-setup.md step 7/9) --
# override if you've deployed your own stack/account, e.g.:
#   TWINER_PROD_SCENARIO_API_URL="https://..." \
#   TWINER_PROD_TILES_API_URL="https://..." \
#   twiner start prod
: "${TWINER_PROD_SCENARIO_API_URL:=https://naw44z44znff5je2ohuyyai7ce0gwpiu.lambda-url.eu-south-2.on.aws/}"
: "${TWINER_PROD_TILES_API_URL:=}"

# First port >= $1 nobody is listening on.
free_port() {
  local port="$1"
  while lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; do
    port=$((port + 1))
  done
  echo "$port"
}

# Commands for the chosen ports (API_PORT/WEB_PORT, set by cmd_start).
# VITE_SCENARIO_API_URL/VITE_TILES_API_URL set here always win over
# apps/web/.env* files (Vite: process.env takes priority over .env-file
# values), so this is the one place mode selection actually happens -- no
# dotenv juggling needed. --strictPort: fail rather than let Vite drift to
# a port other than the one printed.
build_cmds() {
  API_CMD="cd '$REPO_ROOT' && TWINER_BUILDINGS_PATH='$TWINER_BUILDINGS_PATH' TWINER_EXPOSURE_PATH='$TWINER_EXPOSURE_PATH' TWINER_SCENARIO_CACHE='$TWINER_SCENARIO_CACHE' TWINER_DATA_VERSION='$TWINER_DATA_VERSION' TWINER_AEMET_API_KEY='$TWINER_AEMET_API_KEY' uv run --package twiner-scenario uvicorn scenario.local:app --port $API_PORT --reload"
  WEB_CMD_LOCAL="cd '$REPO_ROOT/apps/web' && TWINER_DOCS_PORT='$DOCS_PORT' VITE_SCENARIO_API_URL='http://localhost:$API_PORT' npm run dev -- --port $WEB_PORT --strictPort"
  WEB_CMD_PROD="cd '$REPO_ROOT/apps/web' && TWINER_DOCS_PORT='$DOCS_PORT' VITE_SCENARIO_API_URL='$TWINER_PROD_SCENARIO_API_URL' VITE_TILES_API_URL='$TWINER_PROD_TILES_API_URL' npm run dev -- --port $WEB_PORT --strictPort"
  # Installs the docs' dependencies on first run (a fresh worktree has none).
  DOCS_CMD="cd '$REPO_ROOT/apps/docs' && { [ -d node_modules ] || npm install; } && npm run dev -- --port $DOCS_PORT"
}

is_running() {
  tmux has-session -t "$SESSION" 2>/dev/null
}

cmd_start() {
  local mode="${1:-local}"
  case "$mode" in
    local|prod) ;;
    *)
      echo "twiner: unknown mode '$mode' (expected 'local' or 'prod')" >&2
      exit 2
      ;;
  esac

  if is_running; then
    echo "twiner: already running (session '$SESSION'). Use 'twiner status' or 'twiner attach'."
    exit 0
  fi

  WEB_PORT="$(free_port 5173)"
  DOCS_PORT="$(free_port 4321)"
  if [ "$mode" = "local" ]; then
    API_PORT="$(free_port 8000)"
    build_cmds
    tmux new-session -d -s "$SESSION" -n api "$API_CMD"
    tmux new-window -t "$SESSION" -n web "$WEB_CMD_LOCAL"
    tmux new-window -t "$SESSION" -n docs "$DOCS_CMD"
    tmux set-environment -t "$SESSION" TWINER_URLS "api http://localhost:$API_PORT, web http://localhost:$WEB_PORT, docs http://localhost:$WEB_PORT/docs/"
    echo "twiner: started (local, session '$SESSION')."
    echo "  scenario API: http://localhost:$API_PORT  (tmux window 'api')"
    echo "  web frontend: http://localhost:$WEB_PORT  (tmux window 'web')"
    echo "  docs:         http://localhost:$WEB_PORT/docs/  (tmux window 'docs', port $DOCS_PORT)"
  else
    API_PORT=""
    build_cmds
    tmux new-session -d -s "$SESSION" -n web "$WEB_CMD_PROD"
    tmux new-window -t "$SESSION" -n docs "$DOCS_CMD"
    tmux set-environment -t "$SESSION" TWINER_URLS "web http://localhost:$WEB_PORT, docs http://localhost:$WEB_PORT/docs/"
    echo "twiner: started (prod, session '$SESSION')."
    echo "  scenario API: $TWINER_PROD_SCENARIO_API_URL  (deployed AWS backend, no local API window)"
    echo "  tiles API: ${TWINER_PROD_TILES_API_URL:-<unset -- see TWINER_PROD_TILES_API_URL>}"
    echo "  web frontend: http://localhost:$WEB_PORT  (tmux window 'web')"
    echo "  docs:         http://localhost:$WEB_PORT/docs/  (tmux window 'docs', port $DOCS_PORT)"
    echo "  note: the deployed backend is much slower for large-radius faults"
    echo "  (seconds, not milliseconds) -- see docs/known-issues-cloud-deploy.md."
  fi
  echo "  attach with: twiner attach   (or: tmux attach -t $SESSION)"
}

cmd_stop() {
  if ! is_running; then
    echo "twiner: not running."
    exit 0
  fi
  tmux kill-session -t "$SESSION"
  echo "twiner: stopped."
}

cmd_restart() {
  local mode="${1:-local}"
  is_running && cmd_stop
  cmd_start "$mode"
}

cmd_status() {
  if is_running; then
    echo "twiner: running (session '$SESSION')."
    tmux show-environment -t "$SESSION" TWINER_URLS 2>/dev/null | sed 's/^TWINER_URLS=/  /' || true
    tmux list-windows -t "$SESSION" -F '  #{window_name}: #{pane_current_command}'
  else
    echo "twiner: not running."
  fi
}

cmd_attach() {
  is_running || { echo "twiner: not running. Run 'twiner start' first." >&2; exit 1; }
  tmux attach -t "$SESSION"
}

case "${1:-}" in
  start)   cmd_start "${2:-local}" ;;
  stop)    cmd_stop ;;
  restart) cmd_restart "${2:-local}" ;;
  status)  cmd_status ;;
  attach)  cmd_attach ;;
  *)
    echo "usage: twiner start|restart [local|prod]  |  twiner stop|status|attach" >&2
    exit 2
    ;;
esac
