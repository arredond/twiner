{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:docs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:docs": "npm ci --prefix ../docs && npm run build --prefix ../docs && rm -rf dist/docs && cp -R ../docs/dist dist/docs"
  },
  "dependencies": {
    "@mapbox/maki": "^8.2.0",
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^6.9.1",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "license": "AGPL-3.0-or-later"
}
