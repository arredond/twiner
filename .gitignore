# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv

# Pipeline outputs (parquet, PMTiles, raw downloads) -- regenerate via
# pipelines/*, don't commit multi-hundred-MB source data or its outputs.
data/
# No trailing slash on the root entry below or on apps/web/public/data:
# bin/link-data makes both *symlinks* in linked worktrees, and a `dir/`
# pattern only matches directories. A committed symlink once replaced
# main's real apps/web/public/data with a self-referencing link on merge,
# deleting it (git treats ignored files as disposable on checkout).
/data

# Local copy of buildings.pmtiles for the frontend dev server -- copy it
# from data/exposure/ after running the exposure pipeline (see apps/web/README.md).
apps/web/public/data

# CDK
infra/cdk.out/

# Local mirror of the results S3 bucket -- per-scenario status/stats/
# buildings files written by services/scenario (results_store.py).
results/

# Other
.DS_Store
